generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  PLATFORM_ADMIN
  DOCTOR
  NURSE
  PATIENT
}

model Tenant {
  id             String          @id @default(uuid())
  name           String
  inviteCode     String          @unique
  code           String          @unique
  type           String
  createdAt      DateTime        @default(now())
  status         EntityStatus    @default(ACTIVE)
  deletedAt      DateTime?
  users          User[]
  patients       Patient[]
  doctorPatients DoctorPatient[]
}

model User {
  id       String @id @default(uuid())
  name     String?
  phone    String @unique
  password String
  role     Role
  email    String @unique

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  mustChangePassword Boolean @default(false)

  patient        Patient?
  status         EntityStatus    @default(ACTIVE)
  createdAt      DateTime        @default(now())
  doctorPatients DoctorPatient[] @relation("DoctorRelation")
}

model Patient {
  id          String  @id @default(uuid())
  name        String
  age         Int
  phone       String
  address     String?
  medicalNote String?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  pregnancyStartDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy String // userId (doctor/admin)

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  isDeleted      Boolean         @default(false)
  deletedAt      DateTime?
  doctorMappings DoctorPatient[]
  patientPrograms PatientProgram[]
}

model DoctorPatient {
  id String @id @default(uuid())

  doctorId  String
  patientId String
  tenantId  String
  isPrimary Boolean @default(false)

  doctor  User    @relation("DoctorRelation", fields: [doctorId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])
  tenant  Tenant  @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())

  @@unique([doctorId, patientId]) // prevent duplicate mapping
}

model CareProgram {
  id          String @id @default(uuid())

  name        String @unique
  code        String @unique

  description String?

  isPaid      Boolean @default(false)

  isActive    Boolean @default(true)

  createdAt   DateTime @default(now())

  patientPrograms PatientProgram[]
}

model PatientProgram {
  id String @id @default(uuid())

  patientId String
  programId String

  startDate DateTime
  endDate   DateTime?

  isActive  Boolean @default(true)

  createdAt DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id])
  program CareProgram @relation(fields: [programId], references: [id])

  @@unique([patientId, programId])
}

enum EntityStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}
